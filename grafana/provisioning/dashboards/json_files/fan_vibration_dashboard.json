      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-datasource"
          },
          "query": "from(bucket: \"fan_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\")\n  |> filter(fn: (r) => r[\"fan_id\"] =~ /^${fan_id:regex}$/)\n  |> filter(fn: (r) => r[\"_field\"] == \"vibration\")\n  |> drop(columns: [\"status\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")",
